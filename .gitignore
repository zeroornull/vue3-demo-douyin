# Local archive of the repository before the Bun/Vue migration.
/legacy/

# Local oh-my-codex runtime state.
/.omx/
/.omc/

# Dependencies and build output.
/node_modules/
/dist/
/dist-ssr/
/coverage/
/playwright-report/
/test-results/
*.tsbuildinfo
.eslintcache

# Bun/npm diagnostics.
bun-error.log
*.log

# Reproducible migration evidence. Keep handwritten Markdown, but do not commit
# command logs, machine-generated reports, or browser screenshots.
/docs/round-*/evidence/
/docs/round-*/generated/
/docs/round-*/screenshots/

# Local environment files. Commit only documented examples.
.env
.env.*
!.env.example
!.env.e2e

# OS and editor-local files.
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
