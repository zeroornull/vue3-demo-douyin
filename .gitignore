# Local archive of the repository before the Bun/Vue migration.
/legacy/

# Local oh-my-codex runtime state.
/.omx/

# Dependencies and build output.
/node_modules/
/dist/
/dist-ssr/
/coverage/
/playwright-report/
/test-results/
*.tsbuildinfo
.eslintcache

# Bun/npm diagnostics.
bun-error.log
*.log

# Verification logs under migration rounds are intentional documentation evidence.
!/docs/round-*/evidence/*.log

# Local environment files. Commit only documented examples.
.env
.env.*
!.env.example

# OS and editor-local files.
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Round-0 full resource manifest is reproducible but intentionally local.
/docs/round-0/generated/*.local.json
